PORT=4000

# Optional. Without it the server falls back to an in-memory store.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ask_the_lecture?retryWrites=true&w=majority
MONGODB_URI=

# Required. Answers, refusals and chapter generation.
ANTHROPIC_API_KEY=

# Optional. Transcribes lectures that carry no caption track (anything that
# is not YouTube). Without it those lectures need a pasted transcript.
GROQ_API_KEY=
